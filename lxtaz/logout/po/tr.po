msgid "SliTaz Logout"
msgstr "SliTaz Çıkış"

msgid "SliTaz Logout - Please choose an action:"
msgstr "SliTaz Çık - Lütfen işlem seçin:"

msgid "Close X session"
msgstr "X oturumunu kapat"

msgid "Reboot system"
msgstr "Yeniden başlat"

msgid "Shutdown system"
msgstr "Kapat"

msgid "Cancel"
msgstr "İptal"

msgid "OK"
msgstr "Tamam"

msgid "Closing the X session..."
msgstr "X oturumunu kapatılıyor..."

msgid "Rebooting the system..."
msgstr "Sistem yeniden başlatılıyor..."

msgid "Shutting down the system..."
msgstr "Sistem kapatılıyor..."

#, c-format
msgid "%s\n\nSelected action will be executed automatically in %d seconds."
msgstr "%s\n\nSeçili işlem %d saniye içinde çalıştırılacaktır."

msgid ""
"Usage: lxtaz-logout [exit|reboot|halt] [--force] [--dry-run]\n"
"  no argument shows the logout dialog.\n"
"  --force skips the 5 s confirmation (used by lxtaz-ctrl).\n"
"  --dry-run runs the dialogs but never executes the action (tests)."
msgstr ""
"Kullanım : lxtaz-logout [exit|reboot|halt] [--force] [--dry-run]\n"
"  seçenek yoksa çıkış menüsü gösterilir.\n"
"  --force 5 sn onay süresini es--beklemez (lxtaz-ctrl kullanır).\n"
"  --dry-run pencere iş yapmadan açılır (deneme)."
