#: ../src/lxtaz-su.c:125 ../src/lxtaz-su.c:156
msgid "Administrator rights"
msgstr "Yönetici hakları"

#: ../src/lxtaz-su.c:157
msgid "To run"
msgstr "Çalıştırılacak uygulama:"

#: ../src/lxtaz-su.c:169
#, c-format
msgid "Type the password of <b>your account</b> (%s)."
msgstr "<b>(%s) hesabının</b> şifresini girin."

#: ../src/lxtaz-su.c:172
msgid ""
"Type the password of the <b>root</b> account (system administrator), not "
"yours."
msgstr ""
"<b>root(sistem yöneticisi) </b> şifresini girin, "
"sizin değil."

#: ../src/lxtaz-su.c:185
#, c-format
msgid "Password of %s"
msgstr "%s şifresi"

#: ../src/lxtaz-su.c:189
msgid "Root password"
msgstr "Root şifresi"

#: ../src/lxtaz-su.c:199
msgid "_Cancel"
msgstr "_Vazgeç"

#: ../src/lxtaz-su.c:201
msgid "_OK"
msgstr "_Taman"

#: ../src/lxtaz-su.c:410
msgid "Wrong password, try again."
msgstr "Yanlış şifre, tekrar deneyin."
